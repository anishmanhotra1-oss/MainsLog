# Environment Configuration for MainsLog & The Ink Lab
# Copy this file to .env or configure in Vercel Project Settings

# Google Gemini API Key for Current Affairs Magazine Notes Extractor
# Required for extracting highlights, underlines, handwritten notes, and maps
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Model Routing (Tiered Architecture)
# GEMINI_PRO_MODEL is routed automatically for handwriting-heavy or complex pages
GEMINI_PRO_MODEL=gemini-1.5-pro
# GEMINI_FLASH_MODEL is routed for standard highlight/underline-only pages
GEMINI_FLASH_MODEL=gemini-1.5-flash

# Optional: Server Port (default: 8080)
PORT=8080
