{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "tracker.html", "use": "@vercel/static" },
    { "src": "gs.html", "use": "@vercel/static" },
    { "src": "sociology.html", "use": "@vercel/static" },
    { "src": "pyq.html", "use": "@vercel/static" },
    { "src": "deed.jpg", "use": "@vercel/static" },
    { "src": "manifest.json", "use": "@vercel/static" },
    { "src": "sw.js", "use": "@vercel/static" },
    { "src": "examples-bank.js", "use": "@vercel/static" },
    { "src": "voice-recall.js", "use": "@vercel/static" },
    { "src": "flashcards.css", "use": "@vercel/static" },
    { "src": "flashcards-data.js", "use": "@vercel/static" },
    { "src": "flashcards.js", "use": "@vercel/static" },
    { "src": "framework.css", "use": "@vercel/static" },
    { "src": "topper-value-addition.css", "use": "@vercel/static" },
    { "src": "topper-value-addition.js", "use": "@vercel/static" },
    { "src": "gs-framework.js", "use": "@vercel/static" },
    { "src": "sociology-framework.js", "use": "@vercel/static" },
    { "src": "favicon.ico", "use": "@vercel/static" },
    { "src": "favicon.png", "use": "@vercel/static" },
    { "src": "apple-touch-icon.png", "use": "@vercel/static" },
    { "src": "favicon.svg", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "pyq-data/**", "use": "@vercel/static" },
    { "src": "features/**", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/more/current-affairs-magazines", "dest": "/features/ca-notes/index.html" },
    { "src": "/more/can.css", "dest": "/features/ca-notes/can.css" },
    { "src": "/more/can.js", "dest": "/features/ca-notes/can.js" },
    { "src": "/can.css", "dest": "/features/ca-notes/can.css" },
    { "src": "/can.js", "dest": "/features/ca-notes/can.js" },
    { "src": "/tracker", "dest": "/tracker.html" },
    { "src": "/tracker.html", "dest": "/tracker.html" },
    { "src": "/gs", "dest": "/gs.html" },
    { "src": "/gs.html", "dest": "/gs.html" },
    { "src": "/sociology", "dest": "/sociology.html" },
    { "src": "/sociology.html", "dest": "/sociology.html" },
    { "src": "/pyq", "dest": "/pyq.html" },
    { "src": "/pyq.html", "dest": "/pyq.html" },
    { "src": "/deed.jpg", "dest": "/deed.jpg" },
    { "src": "/api/value-addition", "dest": "/api/value-addition.js" },
    { "src": "/api/sync", "dest": "/api/sync.js" },
    { "src": "/api/ca-extract", "dest": "/api/ca-extract.js" },
    { "src": "/api/tracker/(.*)", "dest": "/api/tracker.js" },
    { "src": "/examples-bank.js", "dest": "/examples-bank.js" },
    { "src": "/voice-recall.js", "dest": "/voice-recall.js" },
    { "src": "/flashcards.css", "dest": "/flashcards.css" },
    { "src": "/flashcards-data.js", "dest": "/flashcards-data.js" },
    { "src": "/flashcards.js", "dest": "/flashcards.js" },
    { "src": "/framework.css", "dest": "/framework.css" },
    { "src": "/topper-value-addition.css", "dest": "/topper-value-addition.css" },
    { "src": "/topper-value-addition.js", "dest": "/topper-value-addition.js" },
    { "src": "/gs-framework.js", "dest": "/gs-framework.js" },
    { "src": "/sociology-framework.js", "dest": "/sociology-framework.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
